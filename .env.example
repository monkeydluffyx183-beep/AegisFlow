# AegisFlow local defaults
APP_ENV=development
DEMO_MODE=true
LOG_LEVEL=INFO
API_PORT=8000
FRONTEND_PORT=5173

# Compose uses Postgres; the API falls back to SQLite when this is omitted.
DATABASE_URL=postgresql+psycopg://aegis:aegis_dev_2026@postgres:5432/aegisflow
REDIS_URL=redis://redis:6379/0
QDRANT_URL=http://qdrant:6333
MLFLOW_TRACKING_URI=http://mlflow:5000
CORS_ORIGINS=http://localhost:5173
SERVICE_API_KEY=local-demo-service-key
JWT_SECRET=local-only-change-me

# Thresholds are persisted and can be rolled back from ModelOps.
REVIEW_THRESHOLD=0.45
DECLINE_THRESHOLD=0.76
